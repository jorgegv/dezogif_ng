{

    "version": "0.2.0",
    "configurations": [

        {
            // Start at the NMI $66
            "type": "dezog",
            "request": "launch",
            "name": "zsim nmi66",
            "remoteType": "zsim",
            "zsim": {
                "Z80N": true,
                //"memoryModel": "ZXNEXT",
                "memoryModel": "ZX48K", // Otherwise, because of loadObj, the file association will not work. Note: all the bank switching does not work if ZX48K is enabled. But it is possible to step.
                "ulaScreen": true,
                "zxKeyboard": true,
                "customCode": {
                    "jsPath": "src/simulation/uart.js",
                }
            },
            "sjasmplus": [
                {
                    "path": "build/dezogif.sld",
                    "srcDirs": [
                        "src"
                    ],
                    "disableBanking": true
                }
            ],
            //"startAutomatically": true,
            "startAutomatically": false,
            "commandsAfterLaunch": [
            ],
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "debug_stack.top",
            "loadObjs": [
                { "path": "build/enNextMf.rom", "start": "0"}
            ],
            "execAddress": "0x0066",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        },

        {
            // For debugging the UI.
            "type": "dezog",
            "request": "launch",
            "name": "zsim test UI (main)",
            "remoteType": "zsim",
            "zsim": {
                "Z80N": true,
                //"memoryModel": "ZXNEXT",
                "memoryModel": "ZX48K", // Otherwise, because of loadObj, the file association will not work.
                "ulaScreen": true,
                "zxKeyboard": true,
                "customCode": {
                    "jsPath": "src/simulation/uart.js",
                }
            },
            "sjasmplus": [
                {
                    "path": "build/dezogif.sld",
                    "srcDirs": [
                        "src"
                    ]
                }
            ],
            "startAutomatically": false,
            "commandsAfterLaunch": [
            ],
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "debug_stack.top",
            "loadObjs": [
                {
                    "path": "build/main.bin",
                    "start": "0xE000"
                }
            ],
            "execAddress": "main_bank_entry",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        },

        {
            "type": "dezog",
            "request": "launch",
            "name": "CSpect MF ROM",
            "remoteType": "cspect",
            "cspect": {
                "hostname": "localhost",
                "port": 11000,
                "socketTimeout": 50
            },
            "sjasmplus": [
                {
                    "path": "build/dezogif.sld",
                    "srcDirs": [
                        "src"
                    ]
                }
            ],
            //"startAutomatically": false,
            "startAutomatically": true,
            "commandsAfterLaunch": [
                //"-logpoint enable",
                "-assertion enable",
                "-md 0 0x100 0xc000 0x100",
                //"-logpoint enable DEFAULT"
                //"-md 0 100 0xc000 100 0x2000 100 0xe000 100"
            ],
            "disassemblerArgs": {
                "esxdosRst": true
            },
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "debug_stack.top",
            "loadObjs": [
                {
                    "path": "build/enNextMf.rom",
                    "start": "MF_ORIGIN_ROM"
                }
            ],
            "execAddress": "MF.init_main_bank",
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        },
        {
            "type": "dezog",
            "request": "launch",
            "name": "ZEsarUX MF ROM",
            "remoteType": "zrcp",
            "sjasmplus": [
                {
                    "path": "build/dezogif.sld",
                    "srcDirs": [
                        "src"
                    ]
                }
            ],
            //"startAutomatically": false,
            "startAutomatically": true,
            "commandsAfterLaunch": [
                //"-logpoint enable",
                //"-assertion enable",
                //"-logpoint enable DEFAULT"
                //"-md 0 100 0xc000 100 0x2000 100 0xe000 100"
            ],
            "disassemblerArgs": {
                "esxdosRst": true
            },
            "rootFolder": "${workspaceFolder}",
            "topOfStack": "debug_stack.top",
            "loadObjs": [
                {
                    "path": "build/enNextMf.rom",
                    "start": "MF_ORIGIN_ROM"
                }
            ],
            "execAddress": "MF.nmi66h", // "NMI" address
            "smallValuesMaximum": 513,
            "tmpDir": ".tmp"
        },

        {
            "type": "dezog",
            "request": "launch",
            "name": "Unit Tests",
            "presentation": {
                "hidden": true
            },
            "unitTests": true,
            "remoteType": "zsim",
            "zsim": {
                "Z80N": true,
                "memoryModel": "ZXNEXT",
                "ulaScreen": true,
                "zxKeyboard": true,
                "customCode": {
                    "jsPath": "src/simulation/uart.js",
                }
            },
            "startAutomatically": true,
            "unitTestTimeout": 2,
            "sjasmplus": [
                {
                    "path": "build/ut.sld",
                    "srcDirs": [
                        "src"
                    ]
                }
            ],
            "rootFolder": "${workspaceFolder}",
            "load": "build/ut.nex",
        }

    ]
}